generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  expenses  Expense[]
  rules     VendorCategoryRule[]
}

model Expense {
  id          Int      @id @default(autoincrement())
  date        DateTime
  amount      Decimal  @db.Decimal(12, 2)
  vendor      String
  description String?
  isAnomaly   Boolean  @default(false)
  createdAt   DateTime @default(now())

  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])

  @@index([date])
  @@index([categoryId])
}

model VendorCategoryRule {
  id         Int      @id @default(autoincrement())
  vendor     String   @unique
  categoryId Int

  category   Category @relation(fields: [categoryId], references: [id])

  createdAt  DateTime @default(now())

  @@index([categoryId])
}